# Base URL of the ServiceDesk AI REST API.
# Local development:  http://localhost:4000/api
# Production:         https://your-api.onrender.com/api
#
# Only VITE_-prefixed variables reach the browser bundle. Never put a secret
# here — anything in this file is publicly visible in the built JavaScript.
VITE_API_BASE_URL=http://localhost:4000/api
