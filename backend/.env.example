# ---------------------------------------------------------------------------
# ServiceDesk AI — backend environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000

# Cloud database (Supabase → Project Settings → Database → Connection string)
# Use the pooled connection string in production.
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Set to "true" for managed providers that require TLS (Supabase, Render, Neon).
DATABASE_SSL=false

# Authentication — generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS — the deployed frontend origin. Comma-separate to allow more than one.
CORS_ORIGIN=http://localhost:5173

# AI provider
# AI_PROVIDER=anthropic  → calls the Claude API (requires AI_API_KEY)
# AI_PROVIDER=fallback   → deterministic rule-based classifier, no network calls
AI_PROVIDER=fallback
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=12000

# WhatsApp channel
# WHATSAPP_PROVIDER=simulator → records messages without sending them. Needs no
#   external account, so the channel is fully demonstrable offline.
# WHATSAPP_PROVIDER=twilio    → sends real messages (requires the values below).
WHATSAPP_PROVIDER=simulator
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=
# The exact public webhook URL — it forms part of the Twilio signature, so it
# must match what the provider is configured to call, character for character.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_TIMEOUT_MS=10000
# Only for Twilio's trial "Try out WhatsApp" sender, which rejects free-form
# text: the HX... SID of a Content Template, and (if the template has one) the
# variable the reply is placed in. Leave blank for the sandbox or production.
WHATSAPP_CONTENT_SID=
WHATSAPP_CONTENT_VARIABLE=
# WHATSAPP_PROVIDER=meta → Meta's WhatsApp Cloud API (free test number).
# From developers.facebook.com → your app → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App → App settings → Basic → App Secret. Signs every webhook delivery.
WHATSAPP_APP_SECRET=
# Any string you choose; entered again in Meta's webhook configuration.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v22.0

# --- Tech Provider platform -------------------------------------------------
# Our own Meta app: the same credentials serve every tenant. The secret
# exchanges Embedded Signup codes and verifies inbound webhooks, so it must
# never reach the browser.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration that defines what the Embedded
# Signup dialog asks a customer to grant.
META_ES_CONFIG_ID=
META_GRAPH_VERSION=v22.0
META_TIMEOUT_MS=15000
# Two-step-verification PIN set when registering a customer's number.
META_REGISTRATION_PIN=000000
# Encrypts tenant access tokens at rest. REQUIRED in production.
# Generate with: openssl rand -hex 32
PLATFORM_ENCRYPTION_KEY=
# Public base URL of this API, shown to tenants as their webhook address.
PLATFORM_PUBLIC_URL=http://localhost:4000

# Seed data — the demo admin created by `npm run seed`
SEED_ADMIN_EMAIL=admin@servicedesk.ai
SEED_ADMIN_PASSWORD=Admin@12345

# Structured logging level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Embeddings for knowledge-base retrieval.
# 'deterministic' computes lexical vectors locally — no key, no network, and
#   honestly NOT semantic. 'openai' calls an OpenAI-compatible endpoint.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_MS=15000
